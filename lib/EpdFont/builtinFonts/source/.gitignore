# Ignore all font directories except those committed to the repo.
# Fonts like NotoSansCJK are downloaded on demand by build-sd-fonts.py.
*
!.gitignore
!NotoSerif/
!NotoSerif/**
!NotoSans/
!NotoSans/**
!NotoSansArabic/
!NotoSansArabic/**
!NotoSansHebrew/
!NotoSansHebrew/**
!SourceSerif4/
!SourceSerif4/**
!SourceSans3/
!SourceSans3/**
!EBGaramond/
!EBGaramond/**
!OpenDyslexic/
!OpenDyslexic/**
!Ubuntu/
!Ubuntu/**
!Inter/
!Inter/**
